# Docker Compose and the app share these local database credentials.
NEO4J_URI=bolt://127.0.0.1:7687
NEO4J_USER=neo4j
NEO4J_PASSWORD=replace-with-your-local-password
NEO4J_HTTP_PORT=7474
NEO4J_BOLT_PORT=7687
# Optional for offline seed; required for TMDB import and real posters.
TMDB_API_KEY=
# Generate: node -e "console.log(require('crypto').randomBytes(32).toString('base64url'))"
AUTH_SECRET=replace-with-a-random-secret
AUTH_URL=http://127.0.0.1:3000

# Optional: popular movie import pages, 1 through 5 (default 1).
TMDB_IMPORT_PAGES=1
